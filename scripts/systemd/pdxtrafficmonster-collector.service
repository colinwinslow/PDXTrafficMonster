[Unit]
Description=PDXTrafficMonster live collector (TriMet GTFS-RT + static GTFS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=claude
Group=claude
Environment=PDXTM_ENV_FILE=/home/claude/.config/pdxtrafficmonster/env
# Installed copy, not the git worktree: a checkout of an older commit must not change what runs.
ExecStart=/usr/bin/python3 /usr/local/lib/pdxtrafficmonster/collect_live.py
# The collector feeds the watchdog per fetch and per downloaded chunk; this only has to exceed
# one request's ceiling (DEADLINE in collect_live.py, max 900 s for gtfs.zip), not a whole cycle.
WatchdogSec=1200
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/claude/data/pdxtrafficmonster
PrivateTmp=true

[Install]
WantedBy=multi-user.target
